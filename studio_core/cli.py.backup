import argparse
from .orchestrator import ProjectOrchestrator

def main():
    parser=argparse.ArgumentParser(description="Groq Website Studio — Phase 1")
    commands=parser.add_subparsers(dest="cmd",required=True)
    new=commands.add_parser("new",help="Create a project")
    new.add_argument("name")
    new.add_argument("--type",dest="business_type",default="")
    new.add_argument("--brief",default="")
    commands.add_parser("projects",help="List projects")
    task=commands.add_parser("task",help="Add a project task")
    task.add_argument("project_id",type=int)
    task.add_argument("title")
    task.add_argument("--description",default="")
    task.add_argument("--agent",default="")
    status=commands.add_parser("status",help="Show project status and tasks")
    status.add_argument("project_id",type=int)
    args=parser.parse_args()
    app=ProjectOrchestrator()
    if args.cmd=="new":
        p=app.create_project(args.name,args.business_type,args.brief)
        print(f"Created project #{p['id']}: {p['name']}\nFolder: {p['root_path']}")
    elif args.cmd=="projects":
        rows=app.store.list_projects()
        print("\n".join(f"#{p['id']} [{p['status']}] {p['name']} — {p['root_path']}" for p in rows) or "No projects yet.")
    elif args.cmd=="task":
        tid=app.add_task(args.project_id,args.title,args.description,args.agent)
        print(f"Created task #{tid}")
    elif args.cmd=="status":
        result=app.project_status(args.project_id)
        print(f"{result['project']['name']} [{result['project']['status']}]")
        for t in result["tasks"]:
            print(f"  #{t['id']} [{t['status']}] {t['title']} — {t['assigned_agent'] or 'unassigned'}")
