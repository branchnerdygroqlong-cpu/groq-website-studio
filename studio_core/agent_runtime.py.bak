"""Connects the Project Manager, Wikimedia image sourcer, and frontend builder."""
import json
import re
from pathlib import Path
from .config import MODELS
from .groq_router import GroqRouter
from .storage import Store

def _clean_html(text):
    text = (text or "").strip()
    if text.startswith("```"):
        text = "\n".join(text.splitlines()[1:])
    if text.endswith("```"):
        text = "\n".join(text.splitlines()[:-1])
    return text.strip()

def _safe_filename(value):
    name = re.sub(r"[^a-zA-Z0-9_-]+", "-", Path(value).stem).strip("-")
    return (name or "image")[:70]

class WebsiteAgents:
    def __init__(self, project, store=None, router=None):
        self.project = project
        self.store = store or Store()
        self.router = router or GroqRouter(self.store)
        self.root = Path(project["root_path"]).resolve()
        self.root.mkdir(parents=True, exist_ok=True)
        self.assets = self.root / "assets"
        self.assets.mkdir(exist_ok=True)
        self.asset_report = "No local images sourced; use CSS/SVG placeholders where appropriate."

    def _write(self, relative, content, mode="w"):
        target = (self.root / relative).resolve()
        if self.root not in target.parents and target != self.root:
            raise ValueError("Refusing to write outside the project directory.")
        target.parent.mkdir(parents=True, exist_ok=True)
        with target.open(mode, encoding="utf-8") as f:
            f.write(content)
        return target

    def source_images(self, brief):
        import requests
        tool_schema = [{
            "type":"function","function":{
                "name":"search_and_download_wikimedia_image",
                "description":"Find a Wikimedia Commons image and download it into this project's assets folder. Only use suitable openly licensed images; report the source and license when available.",
                "parameters":{"type":"object","properties":{
                    "query":{"type":"string"},
                    "filename":{"type":"string"}
                },"required":["query","filename"]}
            }
        }]
        messages = [
            {"role":"system","content":"You source relevant images for websites. For each useful image, call search_and_download_wikimedia_image with a short search query and safe filename. Do not claim a license is public domain unless the API provides that information. If uncertain, skip the image. Finish with a concise report."},
            {"role":"user","content":brief}
        ]
        report = []
        for _ in range(6):
            response = self.router.chat(MODELS["image_agent"], messages, tools=tool_schema,
                                        estimated_out_tokens=500,
                                        fallback_models=[MODELS["dev_agent"], MODELS["pm"]])
            msg = response.choices[0].message
            messages.append(msg)
            if not msg.tool_calls:
                report.append(msg.content or "")
                break
            for call in msg.tool_calls:
                args = json.loads(call.function.arguments)
                result = self._download_wikimedia(requests, args["query"], args["filename"])
                report.append(result)
                messages.append({"role":"tool","tool_call_id":call.id,
                                 "name":call.function.name,"content":result})
        self.asset_report = "\n".join(report) or "No images downloaded."
        return self.asset_report

    def _download_wikimedia(self, requests, query, filename):
        api = "https://commons.wikimedia.org/w/api.php"
        headers = {"User-Agent":"GroqWebsiteStudio/0.2 (local website development)"}
        try:
            response = requests.get(api, params={
                "action":"query","format":"json","generator":"search",
                "gsrsearch":f"filetype:bitmap {query}","gsrnamespace":6,
                "gsrlimit":5,"prop":"imageinfo","iiprop":"url|extmetadata"
            }, headers=headers, timeout=20)
            response.raise_for_status()
            pages = response.json().get("query",{}).get("pages",{})
            for page in pages.values():
                info = (page.get("imageinfo") or [{}])[0]
                url = info.get("url","")
                if not url.lower().split("?")[0].endswith((".jpg",".jpeg",".png",".webp")):
                    continue
                download = requests.get(url, headers=headers, timeout=25)
                download.raise_for_status()
                ext = Path(url.split("?")[0]).suffix.lower()
                name = _safe_filename(filename) + ext
                (self.assets / name).write_bytes(download.content)
                metadata = info.get("extmetadata",{})
                license_name = metadata.get("LicenseShortName",{}).get("value","license not confirmed")
                page_url = page.get("canonicalurl", "Wikimedia Commons")
                return f"Downloaded assets/{name}; source: {page_url}; license metadata: {license_name}. Verify usage terms before publication."
            return f"No suitable image found for '{query}'; use a CSS/SVG fallback."
        except Exception as exc:
            return f"Image search failed for '{query}': {exc}. Use a CSS/SVG fallback."

    def build_page(self, design_summary, chunks):
        if not isinstance(chunks, list) or not 1 <= len(chunks) <= 12:
            raise ValueError("The Project Manager must provide between 1 and 12 build chunks.")
        rolling_context = ""
        for index, chunk in enumerate(chunks, 1):
            title = str(chunk.get("chunk_title", f"Section {index}"))[:160]
            instructions = str(chunk.get("instructions", ""))[:12000]
            estimate = max(300, min(int(chunk.get("estimated_tokens", 1100)), 1600))
            if index == 1:
                position = "FIRST chunk: output a complete HTML5 document opening through the start of body. Include head, responsive metadata, and open body. Do not close body/html."
            elif index == len(chunks):
                position = "FINAL chunk: output the final page sections and close body and html."
            else:
                position = "MIDDLE chunk: output only body content sections; no document/head/body wrapper."
            messages = [
                {"role":"system","content":(
                    "You are a senior frontend developer. Output only valid raw HTML, no Markdown fences or commentary. "
                    "Use semantic accessible HTML and responsive CSS. Avoid fake testimonials, fabricated claims, or invented certifications. "
                    + position)},
                {"role":"user","content":(
                    f"Project: {self.project['name']}\nDesign: {design_summary}\n"
                    f"Local assets: {self.asset_report}\nPrior sections: {rolling_context or 'None'}\n"
                    f"Chunk {index}/{len(chunks)} — {title}\nRequirements: {instructions}\n"
                    "Use relative asset paths such as assets/example.jpg where applicable."
                )}
            ]
            response = self.router.chat(MODELS["dev_agent"], messages,
                                        estimated_out_tokens=estimate,
                                        fallback_models=[MODELS["dev_fallback"], MODELS["fast_worker"]])
            html = _clean_html(response.choices[0].message.content)
            if not html:
                raise RuntimeError(f"Frontend agent returned empty output for {title}.")
            self._write("index.html", html + "\n", "w" if index == 1 else "a")
            rolling_context += f"- {title}\n"
        return f"Built {len(chunks)} chunks into {self.root / 'index.html'}"

    def run(self, brief):
        """Interactive PM loop; generated tasks and execution results persist in SQLite."""
        task_id = self.store.add_task(self.project["id"], "Plan and build website",
                                      brief, "project_manager")
        self.store.update_task(task_id, "running")
        pm_tools = [
            {"type":"function","function":{
                "name":"delegate_website_build",
                "description":"Plan and start the website build after understanding the brief.",
                "parameters":{"type":"object","properties":{
                    "image_brief":{"type":"string"},
                    "site_design_summary":{"type":"string"},
                    "build_chunks":{"type":"array","items":{"type":"object","properties":{
                        "chunk_title":{"type":"string"},"instructions":{"type":"string"},
                        "estimated_tokens":{"type":"integer"}},
                        "required":["chunk_title","instructions","estimated_tokens"]}}
                },"required":["image_brief","site_design_summary","build_chunks"]}
            }},
        ]
        messages = [
            {"role":"system","content":(
                "You are the project manager for a multi-page website studio. For this integration test, build ONE complete "
                "high-quality homepage for the project brief. Plan 4-6 sequential HTML chunks from document head/hero through "
                "content, calls to action, footer, and closing tags. Do not invent business facts. Once ready, call "
                "delegate_website_build exactly once. Include design system details and image brief.")},
            {"role":"user","content":brief}
        ]
        try:
            self.store.update_project_status(self.project["id"], "building")
            for _ in range(4):
                response = self.router.chat(MODELS["pm"], messages, tools=pm_tools,
                                            estimated_out_tokens=2200,
                                            fallback_models=[MODELS["dev_agent"], MODELS["image_agent"]])
                msg = response.choices[0].message
                messages.append(msg)
                if not msg.tool_calls:
                    raise RuntimeError("Project Manager did not dispatch delegate_website_build. Response: " + (msg.content or ""))
                for call in msg.tool_calls:
                    if call.function.name != "delegate_website_build":
                        raise RuntimeError(f"Unexpected Project Manager tool: {call.function.name}")
                    args = json.loads(call.function.arguments)
                    image_task = self.store.add_task(self.project["id"], "Source website images", args["image_brief"], "image_sourcer")
                    self.store.update_task(image_task, "running")
                    try:
                        self.source_images(args["image_brief"])
                        self.store.update_task(image_task, "completed", self.asset_report)
                    except Exception as image_exc:
                        self.store.update_task(image_task, "failed", str(image_exc))
                        raise
                    frontend_task = self.store.add_task(self.project["id"], "Generate homepage HTML", args["site_design_summary"], "frontend_developer")
                    self.store.update_task(frontend_task, "running")
                    try:
                        result = self.build_page(args["site_design_summary"], args["build_chunks"])
                        self.store.update_task(frontend_task, "completed", result)
                    except Exception as frontend_exc:
                        self.store.update_task(frontend_task, "failed", str(frontend_exc))
                        raise
                    self._write("BUILD_REPORT.txt",
                                f"Project: {self.project['name']}\\n{result}\\n\\nImage report:\\n{self.asset_report}\\n")
                    self.store.update_task(task_id, "completed", result)
                    self.store.update_project_status(self.project["id"], "built")
                    return result
            raise RuntimeError("Project Manager dispatch limit reached.")
        except Exception as exc:
            self.store.update_task(task_id, "failed", str(exc))
            self.store.update_project_status(self.project["id"], "build_failed")
            raise
