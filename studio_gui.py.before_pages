#!/usr/bin/env python3
"""Groq Website Studio - local web interface.

Run:  python studio_gui.py
Opens http://127.0.0.1:8765 in your browser. Type a prompt, press Build, watch the
progress, and the finished site opens when the build completes.
Uses only the Python standard library plus the existing studio_core package.
"""
import json
import mimetypes
import os
import re
import socket
import sys
import threading
import time
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse

BASE = Path(__file__).resolve().parent
os.chdir(BASE)  # same relative paths (projects/, studio_data/) as the CLI

try:  # optional: pick up GROQ_API_KEY from a .env file
    from dotenv import load_dotenv
    load_dotenv(BASE / ".env")
except Exception:
    pass

from studio_core.agent_runtime import WebsiteAgents  # noqa: E402
from studio_core.config import PROJECTS_DIR  # noqa: E402
from studio_core.orchestrator import ProjectOrchestrator  # noqa: E402

PROJECTS = (BASE / PROJECTS_DIR).resolve()
PROJECTS.mkdir(parents=True, exist_ok=True)


# --------------------------------------------------------------------------- #
# Capture each build's printed progress (print() calls inside the agents/router)
# --------------------------------------------------------------------------- #
class Job:
    def __init__(self, job_id):
        self.id = job_id
        self.state = "running"      # running | done | failed
        self.lines = []
        self._buf = ""
        self.site_url = None
        self.error = None
        self.lock = threading.Lock()

    def feed(self, text):
        with self.lock:
            self._buf += text
            while "\n" in self._buf:
                line, self._buf = self._buf.split("\n", 1)
                if line.strip():
                    self.lines.append(line.rstrip())

    def log(self, line):
        self.feed(line + "\n")


class _StdoutRouter:
    """Sends print() output to the current thread's job (and still to the terminal)."""

    def __init__(self, real):
        self.real = real
        self.local = threading.local()

    def write(self, text):
        job = getattr(self.local, "job", None)
        if job is not None:
            job.feed(text)
        return self.real.write(text)

    def flush(self):
        self.real.flush()

    def isatty(self):
        return False


ROUTER = _StdoutRouter(sys.stdout)
sys.stdout = ROUTER

JOBS = {}
BUILD_LOCK = threading.Lock()   # one build at a time: the free tier cannot sustain more


def slugify(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "new-project"


def unique_name(name):
    candidate, n = name, 1
    while (PROJECTS / slugify(candidate)).exists():
        n += 1
        candidate = f"{name} {n}"
    return candidate


def run_job(job, name, business_type, brief):
    ROUTER.local.job = job
    try:
        app = ProjectOrchestrator()
        project = app.create_project(name, business_type, brief)
        job.log(f"Created project #{project['id']}: {project['name']}")
        WebsiteAgents(project, store=app.store).run(brief)
        folder = Path(project["root_path"]).name
        job.site_url = f"/sites/{folder}/index.html"
        job.state = "done"
        job.log("Build complete.")
    except Exception as exc:  # noqa: BLE001 - show every failure in the UI
        job.error = str(exc)
        job.state = "failed"
        job.log(f"ERROR: {exc}")
    finally:
        ROUTER.local.job = None
        BUILD_LOCK.release()


def list_sites():
    sites = []
    for folder in sorted(PROJECTS.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True):
        if (folder / "index.html").is_file():
            sites.append({"name": folder.name, "url": f"/sites/{folder.name}/index.html"})
    return sites


# --------------------------------------------------------------------------- #
# Web page
# --------------------------------------------------------------------------- #
PAGE = r"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Groq Website Studio</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--ink:#16181d;--muted:#5d6572;--line:#dfe3ea;--brand:#4f46e5;--ok:#15803d;--bad:#b91c1c}
@media (prefers-color-scheme:dark){:root{--bg:#0f1115;--card:#181b22;--ink:#eceef2;--muted:#9aa3b2;--line:#2a2f3a;--brand:#818cf8;--ok:#4ade80;--bad:#f87171}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,Segoe UI,Arial,sans-serif}
main{max-width:820px;margin:0 auto;padding:2rem 1rem 4rem}
h1{margin:.2rem 0 .2rem;font-size:1.8rem}.sub{color:var(--muted);margin:0 0 1.5rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:1.25rem;margin-bottom:1.25rem}
label{display:block;font-weight:600;margin:.9rem 0 .3rem}label:first-child{margin-top:0}
input,textarea{width:100%;padding:.7rem .8rem;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font:inherit}
textarea{min-height:150px;resize:vertical}
button,.btn{display:inline-block;margin-top:1rem;padding:.8rem 1.4rem;border:0;border-radius:10px;background:var(--brand);color:#fff;font:inherit;font-weight:700;cursor:pointer;text-decoration:none}
button:disabled{opacity:.5;cursor:not-allowed}
.status{display:flex;align-items:center;gap:.6rem;font-weight:600}
.dot{width:.7rem;height:.7rem;border-radius:50%;background:var(--brand);animation:pulse 1.2s infinite}
.dot.done{background:var(--ok);animation:none}.dot.failed{background:var(--bad);animation:none}
@keyframes pulse{50%{opacity:.25}}
@media (prefers-reduced-motion:reduce){.dot{animation:none}}
pre{margin:.9rem 0 0;max-height:340px;overflow:auto;padding:.9rem;background:var(--bg);border:1px solid var(--line);border-radius:10px;font:13px/1.45 ui-monospace,Consolas,monospace;white-space:pre-wrap}
.hint{color:var(--muted);font-size:.9rem;margin:.4rem 0 0}.hidden{display:none}
ul.sites{list-style:none;margin:0;padding:0}ul.sites li{padding:.4rem 0;border-bottom:1px solid var(--line)}
a{color:var(--brand)}.err{color:var(--bad);font-weight:600}
</style></head><body><main>
<h1>Groq Website Studio</h1>
<p class="sub">Describe a website, press Build, and the finished page opens when it is ready.</p>
<div class="card">
  <label for="name">Website name (optional)</label>
  <input id="name" placeholder="e.g. Edwin's Page">
  <label for="brief">Describe the website you want</label>
  <textarea id="brief" placeholder="e.g. Homepage for a neighborhood bakery: sourdough, pastries, custom cakes, warm colors, order-inquiry form. Leave hours and phone as placeholders."></textarea>
  <p class="hint">Include the type of site, sections, tone and colors. Anything you do not specify (hours, phone, prices) becomes a [placeholder].</p>
  <button id="go">Build website</button>
</div>
<div class="card hidden" id="progress">
  <div class="status"><span class="dot" id="dot"></span><span id="phase">Starting...</span></div>
  <pre id="log"></pre>
  <p class="hint">A build usually takes a few minutes. Short waits are normal on the free tier.</p>
  <div id="result" class="hidden"><a class="btn" id="open" target="_blank" rel="noopener">Open your website</a></div>
</div>
<div class="card"><strong>Previous sites</strong><ul class="sites" id="sites"></ul></div>
</main>
<script>
const $=id=>document.getElementById(id);let timer=null,job=null,since=0;
function phaseFrom(line){
  if(/\[images\]/.test(line))return"Sourcing images";
  if(/waiting \d+s/.test(line))return"Waiting for the free-tier rate limit (normal)";
  if(/HTML /.test(line))return"Writing page sections";
  if(/CSS /.test(line))return"Styling the page";
  if(/Created project/.test(line))return"Planning the site";
  return null;}
async function loadSites(){
  const r=await fetch("/api/sites");const list=await r.json();const ul=$("sites");ul.innerHTML="";
  if(!list.length){ul.innerHTML="<li>None yet.</li>";return;}
  list.forEach(s=>{const li=document.createElement("li");const a=document.createElement("a");
    a.href=s.url;a.target="_blank";a.rel="noopener";a.textContent=s.name;li.appendChild(a);ul.appendChild(li);});}
async function poll(){
  const r=await fetch(`/api/status?job=${job}&since=${since}`);const d=await r.json();
  d.lines.forEach(l=>{$("log").textContent+=l+"\n";const p=phaseFrom(l);if(p)$("phase").textContent=p;});
  since=d.next;$("log").scrollTop=$("log").scrollHeight;
  if(d.state==="done"){clearInterval(timer);$("dot").className="dot done";$("phase").textContent="Done - your website is ready";
    $("open").href=d.site_url;$("result").classList.remove("hidden");$("go").disabled=false;loadSites();window.open(d.site_url,"_blank");}
  else if(d.state==="failed"){clearInterval(timer);$("dot").className="dot failed";
    $("phase").innerHTML='<span class="err">Build failed - see the log below</span>';$("go").disabled=false;}}
$("go").onclick=async()=>{
  const brief=$("brief").value.trim();
  if(brief.length<10){alert("Please describe the website you want (at least a sentence).");return;}
  $("go").disabled=true;$("progress").classList.remove("hidden");$("result").classList.add("hidden");
  $("log").textContent="";$("dot").className="dot";$("phase").textContent="Starting...";since=0;
  const r=await fetch("/api/build",{method:"POST",headers:{"Content-Type":"application/json"},
    body:JSON.stringify({name:$("name").value.trim(),brief})});
  const d=await r.json();
  if(!r.ok){$("dot").className="dot failed";$("phase").innerHTML='<span class="err"></span>';
    $("phase").firstChild.textContent=d.error||"Could not start the build";$("go").disabled=false;return;}
  job=d.job;timer=setInterval(poll,1000);};
loadSites();
</script></body></html>
"""


# --------------------------------------------------------------------------- #
# HTTP server
# --------------------------------------------------------------------------- #
class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):  # keep the terminal for build progress
        pass

    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode("utf-8")
        elif isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        url = urlparse(self.path)
        if url.path == "/":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if url.path == "/api/sites":
            return self._send(200, list_sites())
        if url.path == "/api/status":
            query = parse_qs(url.query)
            job = JOBS.get((query.get("job") or [""])[0])
            if not job:
                return self._send(404, {"error": "unknown job"})
            since = int((query.get("since") or ["0"])[0] or 0)
            with job.lock:
                lines = job.lines[since:]
                nxt = len(job.lines)
            return self._send(200, {"state": job.state, "lines": lines, "next": nxt,
                                    "site_url": job.site_url, "error": job.error})
        if url.path.startswith("/sites/"):
            return self._serve_site(unquote(url.path[len("/sites/"):]))
        self._send(404, {"error": "not found"})

    def _serve_site(self, relative):
        target = (PROJECTS / relative).resolve()
        if PROJECTS not in target.parents and target != PROJECTS:
            return self._send(403, {"error": "forbidden"})
        if target.is_dir():
            target = target / "index.html"
        if not target.is_file():
            return self._send(404, {"error": "not found"})
        ctype = mimetypes.guess_type(str(target))[0] or "application/octet-stream"
        if ctype.startswith("text/") or ctype in ("application/javascript", "image/svg+xml"):
            ctype += "; charset=utf-8"
        self._send(200, target.read_bytes(), ctype)

    def do_POST(self):
        if urlparse(self.path).path != "/api/build":
            return self._send(404, {"error": "not found"})
        try:
            length = int(self.headers.get("Content-Length", "0"))
            data = json.loads(self.rfile.read(length) or b"{}")
        except (ValueError, json.JSONDecodeError):
            return self._send(400, {"error": "invalid request"})
        brief = str(data.get("brief", "")).strip()
        if len(brief) < 10:
            return self._send(400, {"error": "Please describe the website you want."})
        if not os.getenv("GROQ_API_KEY"):
            return self._send(400, {"error": "GROQ_API_KEY is not set. Stop the server, "
                                             "run: export GROQ_API_KEY='your-key', and start again."})
        if not BUILD_LOCK.acquire(blocking=False):
            return self._send(409, {"error": "A build is already running. Wait for it to finish."})
        name = unique_name(str(data.get("name", "")).strip()[:60]
                           or f"Website {time.strftime('%Y-%m-%d %H%M')}")
        job = Job(f"{int(time.time() * 1000)}")
        JOBS[job.id] = job
        threading.Thread(target=run_job, args=(job, name, "", brief), daemon=True).start()
        self._send(200, {"job": job.id, "name": name})


def free_port(start=8765):
    for port in range(start, start + 20):
        with socket.socket() as probe:
            if probe.connect_ex(("127.0.0.1", port)) != 0:
                return port
    raise RuntimeError("No free port found between 8765 and 8784.")


def main():
    port = free_port()
    server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{port}"
    print(f"Groq Website Studio running at {url}   (Ctrl-C to stop)", flush=True)
    if not os.getenv("GROQ_API_KEY"):
        print("WARNING: GROQ_API_KEY is not set; builds will be refused until it is.", flush=True)
    threading.Timer(0.8, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")


if __name__ == "__main__":
    main()
